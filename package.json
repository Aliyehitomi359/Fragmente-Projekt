{
  "name": "fragmente-projekt",
  "private": true,
  "description": "Local-first poem collage and image fragment workspace",
  "main": "electron/main.cjs",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "org.fragmenteprojekt.desktop",
    "productName": "Fragmente-Projekt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "html-to-image": "latest",
    "idb": "latest",
    "pngjs": "^7.0.0",
    "react": "latest",
    "react-dom": "latest",
    "tesseract.js": "latest",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "latest",
    "vite": "^8.3.5"
  }
}
